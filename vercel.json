{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "output/**",
      "use": "static"
    }
  ],
  "routes": [
    {
      "src": "/api/generate",
      "dest": "api/generate.py"
    },
    {
      "src": "/api/latest",
      "dest": "api/latest.py"
    },
    {
      "src": "/(.*)",
      "dest": "output/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/generate",
      "schedule": "0 8 * * 6"
    }
  ]
}
