{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/generate",
      "dest": "api/generate.py"
    },
    {
      "src": "/api/latest",
      "dest": "api/latest.py"
    },
    {
      "src": "/wordcloud/(.*)",
      "dest": "output/wordcloud/$1"
    },
    {
      "src": "/weekly/(.*)",
      "dest": "output/weekly/$1"
    },
    {
      "src": "/(.*)",
      "dest": "output/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/generate",
      "schedule": "0 8 * * 6"
    }
  ],
  "python": {
    "requirements": "requirements.txt"
  }
}
